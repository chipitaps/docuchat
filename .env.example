# Get a free key at https://aistudio.google.com/apikey
# Use a project WITHOUT billing attached to stay on the free tier.
GEMINI_API_KEY=

# Local development only (npm run dev). Postgres with the pgvector extension, e.g. Neon free tier: https://neon.tech
# Not needed with Docker Compose: it starts its own database.
DATABASE_URL=

# Docker Compose only
# PORT=3000
# POSTGRES_PASSWORD=docuchat

# Optional overrides
# GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
# Takes over automatically when the primary is out of quota, overloaded or slow.
# Free daily limits are small and differ per model (gemini-3.6-flash: 20/day), so keep a fallback.
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
